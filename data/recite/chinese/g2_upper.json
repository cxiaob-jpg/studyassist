   "kind": "poem",
   "front": "墙角数枝梅",
   "back": "凌寒独自开",
   "note": "梅花冒着严寒独自开。遥知不是雪、为有暗香来是后两句。"
  },
  {
   "id": "cnc_p095_q1",
   "kind": "poem",
   "front": "白日依山尽",
   "back": "黄河入海流",
   "note": "先写太阳靠着山落下，黄河流向大海，后面才是欲穷千里目。"
  },
  {
   "id": "cnc_p095_q2",
   "kind": "poem",
   "front": "欲穷千里目",
   "back": "更上一层楼",
   "note": "想看到更远的地方，就要再上一层楼。"
  },
  {
   "id": "cnc_p096_q1",
   "kind": "poem",
   "front": "日照香炉生紫烟",
   "back": "遥看瀑布挂前川",
   "note": "先写远远看见瀑布挂在山前，后面才写飞流直下。"
  },
  {
   "id": "cnc_p096_q2",
   "kind": "poem",
   "front": "飞流直下三千尺",
   "back": "疑是银河落九天",
   "note": "瀑布像银河从九天上落下来。白发三千丈是另一首诗，不要装进来。"
  },
  {
   "id": "cnc_p104_q4",
   "kind": "poem",
   "front": "少年不知勤学苦",
   "back": "老来方知读书迟",
   "note": "年少不懂得刻苦学，老了才觉得读书迟了。后面两句是另两条勤学的话。"
  },
  {
   "id": "cnc_p110_q1",
   "kind": "poem",
   "front": "千山鸟飞绝",
   "back": "万径人踪灭",
   "note": "先写山和路都没有人鸟，后面才是江上的渔翁。"
  },
  {
   "id": "cnc_p110_q2",
   "kind": "poem",
   "front": "孤舟蓑笠翁",
   "back": "独钓寒江雪",
   "note": "一个披蓑戴笠的老人，独自在大雪的江面上钓鱼。"
  },
  {
   "id": "cnc_p111_q1",
   "kind": "poem",
   "front": "敕勒川，阴山下",
   "back": "天似穹庐，笼盖四野",
   "note": "先把天比作毡帐，笼盖着四面的原野，后面才是天苍苍、野茫茫。"
  },
  {
   "id": "cnc_p111_q2",
   "kind": "poem",
   "front": "天苍苍，野茫茫",
   "back": "风吹草低见牛羊",
   "note": "风一吹，草低下去，牛羊就露出来。这里写的是「见」，不是「现」。"
  },
  {
   "id": "cnc_p114_q1",
   "kind": "poem",
   "front": "危楼高百尺",
   "back": "手可摘星辰",
   "note": "楼高得好像一伸手就能摘到星星，后面才写不敢高声说话。"
  },
