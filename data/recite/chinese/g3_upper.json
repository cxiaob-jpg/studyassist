 "cards": [
  {
   "id": "cnc_p163_q1",
   "kind": "poem",
   "front": "湖光秋月两相和",
   "back": "潭面无风镜未磨",
   "note": "湖光和秋月融在一起，后面才写无风的湖面像没有磨过的铜镜。"
  },
  {
   "id": "cnc_p163_q2",
   "kind": "poem",
   "front": "遥望洞庭山水翠",
   "back": "白银盘里一青螺",
   "note": "远远望去，山水苍翠。下一句才把湖和山比成银盘和青螺。孤帆是《望天门山》里的，淡妆浓抹是写西湖的。"
  },
  {
   "id": "cnc_p164_q1",
   "kind": "poem",
   "front": "远上寒山石径斜",
   "back": "白云生处有人家",
   "note": "统编教材这句是「白云生处有人家」。停车、霜叶是后两句。"
  },
  {
   "id": "cnc_p164_q2",
   "kind": "poem",
   "front": "停车坐爱枫林晚",
   "back": "霜叶红于二月花",
   "note": "因为爱这傍晚的枫林，才停下车。下一句才写霜叶比二月的花还红。"
  },
  {
   "id": "cnc_p165_q1",
   "kind": "poem",
   "front": "萧萧梧叶送寒声",
   "back": "江上秋风动客情",
   "note": "梧叶带来寒意，秋风牵动了旅人想家的心情。挑促织、一灯明是后两句。"
  },
  {
   "id": "cnc_p165_q2",
   "kind": "poem",
   "front": "知有儿童挑促织",
   "back": "夜深篱落一灯明",
   "note": "儿童在捉蟋蟀，篱笆边有一盏灯。霜叶是《山行》里的句子。"
  },
  {
   "id": "cnc_p189_q1",
   "kind": "poem",
   "front": "空山不见人",
   "back": "但闻人语响",
   "note": "看不见人，却听得见说话的声音。返景、青苔是后两句。是「闻」，不是「见」。"
  },
  {
   "id": "cnc_p189_q2",
   "kind": "poem",
   "front": "返景入深林",
   "back": "复照青苔上",
   "note": "夕阳的光射进树林，又照在青苔上。人语响是第二句。"
  },
  {
   "id": "cnc_p190_q1",
   "kind": "poem",
   "front": "天门中断楚江开",
   "back": "碧水东流至此回",
   "note": "江水向东流到这里打了个回旋。教材这句是「至此回」。"
  },
  {
   "id": "cnc_p190_q2",
   "kind": "poem",
   "front": "两岸青山相对出",
   "back": "孤帆一片日边来",
   "note": "两岸青山对面涌出，一只帆船从日边驶来。"
  },
  {
   "id": "cnc_p191_q1",
   "kind": "poem",
   "front": "水光潋滟晴方好",
   "back": "山色空蒙雨亦奇",
   "note": "晴天的水光很好，雨天的山色也很奇妙。接天莲叶是杨万里的句子。"
  },
  {
   "id": "cnc_p191_q2",
   "kind": "poem",
   "front": "欲把西湖比西子",
   "back": "淡妆浓抹总相宜",
   "note": "西湖不论晴雨都美，就像西施淡妆浓抹都很合适。"
  },
  {
