   "id": "cnc_p200_q1",
   "kind": "poem",
   "front": "迟日江山丽",
   "back": "春风花草香",
   "note": "迟日江山丽，春风花草香。泥融、沙暖是后两句。两个黄鹂是另一首《绝句》。"
  },
  {
   "id": "cnc_p200_q2",
   "kind": "poem",
   "front": "泥融飞燕子",
   "back": "沙暖睡鸳鸯",
   "note": "泥土化开，燕子飞来；沙子变暖，鸳鸯在睡觉。"
  },
  {
   "id": "cnc_p201_q1",
   "kind": "poem",
   "front": "竹外桃花三两枝",
   "back": "春江水暖鸭先知",
   "note": "先写鸭子知道江水暖了。蒌蒿、河豚是后两句。是鸭，不是鹅。"
  },
  {
   "id": "cnc_p201_q2",
   "kind": "poem",
   "front": "蒌蒿满地芦芽短",
   "back": "正是河豚欲上时",
   "note": "蒌蒿长满地，芦芽还短，这正是河豚要逆流而上的时候。"
  },
  {
   "id": "cnc_p202_q1",
   "kind": "poem",
   "front": "梅子黄时日日晴",
   "back": "小溪泛尽却山行",
   "note": "梅子黄的时节天天放晴，小溪走到头，人改走山路。绿阴、黄鹂是后两句。"
  },
  {
   "id": "cnc_p202_q2",
   "kind": "poem",
   "front": "绿阴不减来时路",
   "back": "添得黄鹂四五声",
   "note": "回来时树荫并不比来时少，只是多了四五声黄鹂。两个黄鹂鸣翠柳是杜甫的另一首诗。"
  },
  {
   "id": "cnc_p217_q1",
   "kind": "poem",
   "front": "爆竹声中一岁除",
   "back": "春风送暖入屠苏",
   "note": "爆竹送走旧年，人们喝着屠苏酒。千门万户是后两句。"
  },
  {
   "id": "cnc_p217_q2",
   "kind": "poem",
   "front": "千门万户曈曈日",
   "back": "总把新桃换旧符",
   "note": "太阳照进千家万户，人们把旧桃符换成新的。不能把新桃、旧符说反。"
  },
  {
   "id": "cnc_p218_q1",
   "kind": "poem",
   "front": "清明时节雨纷纷",
   "back": "路上行人欲断魂",
   "note": "清明细雨，路上的行人伤心极了。借问酒家是后两句。"
  },
  {
   "id": "cnc_p218_q2",
   "kind": "poem",
   "front": "借问酒家何处有",
   "back": "牧童遥指杏花村",
   "note": "行人问哪里有酒家，牧童远远指向杏花村。"
  },
  {
   "id": "cnc_p219_q1",
   "kind": "poem",
   "front": "独在异乡为异客",
   "back": "每逢佳节倍思亲",
   "note": "独自在外地作客，每到节日就更加想念亲人。登高、茱萸是后两句。屠苏是《元日》里的酒。"
  },
  {
   "id": "cnc_p219_q2",
   "kind": "poem",
   "front": "遥知兄弟登高处",
   "back": "遍插茱萸少一人",
   "note": "诗人想到兄弟们重阳登高、插茱萸，少的是他自己这一个。不能说成少两人。"
  },
