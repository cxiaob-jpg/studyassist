 "cards": [
  {
   "id": "cnc_p250_q1",
   "kind": "poem",
   "front": "一道残阳铺水中",
   "back": "半江瑟瑟半江红",
   "note": "江面一半是深青，一半被残阳照红。后两句才写九月初三的夜。"
  },
  {
   "id": "cnc_p250_q2",
   "kind": "poem",
   "front": "可怜九月初三夜",
   "back": "露似真珠月似弓",
   "note": "露水像珍珠，月亮像弓。诗里写的是真珠。"
  },
  {
   "id": "cnc_p251_q1",
   "kind": "poem",
   "front": "横看成岭侧成峰",
   "back": "远近高低各不同",
   "note": "从不同的距离、不同的高度看，山的样子各不相同。"
  },
  {
   "id": "cnc_p251_q2",
   "kind": "poem",
   "front": "不识庐山真面目",
   "back": "只缘身在此山中",
   "note": "诗中用「只缘」，不是「只因」，也不是「人在」。"
  },
  {
   "id": "cnc_p252_q1",
   "kind": "poem",
   "front": "梅雪争春未肯降",
   "back": "骚人阁笔费评章",
   "note": "梅和雪都说自己更能代表春，诗人搁下笔，不好立刻评判。"
  },
  {
   "id": "cnc_p252_q2",
   "kind": "poem",
   "front": "梅须逊雪三分白",
   "back": "雪却输梅一段香",
   "note": "梅没有雪那么白，雪却没有梅的香。两句是一对。"
  },
  {
   "id": "cnc_p277_q1",
   "kind": "poem",
   "front": "葡萄美酒夜光杯",
   "back": "欲饮琵琶马上催",
   "note": "正要举杯，马上的琵琶已经催人出发。醉卧沙场是后两句。秦时明月是《出塞》。"
  },
  {
   "id": "cnc_p277_q2",
   "kind": "poem",
   "front": "醉卧沙场君莫笑",
   "back": "古来征战几人回",
   "note": "醉倒在沙场上请你别笑，自古出征能回来的人很少。阴山是《出塞》，江东是《夏日绝句》。"
  },
  {
   "id": "cnc_p278_q1",
   "kind": "poem",
   "front": "秦时明月汉时关",
   "back": "万里长征人未还",
   "note": "出塞先写远征的人还没有回来。是万里，不是千里；是未还，不是未归。"
  },
  {
   "id": "cnc_p278_q2",
   "kind": "poem",
   "front": "但使龙城飞将在",
   "back": "不教胡马度阴山",
   "note": "只要有飞将军在，就不让胡马越过阴山。诗中是不教，不是不叫。葡萄美酒是《凉州词》。"
  },
  {
   "id": "cnc_p279_q1",
   "kind": "poem",
   "front": "生当作人杰",
   "back": "死亦为鬼雄",
   "note": "先说活着要做人中的豪杰，死了也要做鬼中的英雄。诗中是鬼雄，不是英雄。"
  },
  {
   "id": "cnc_p279_q2",
   "kind": "poem",
   "front": "至今思项羽",
   "back": "不肯过江东",
   "note": "诗人想起项羽不肯逃回江东。过江东不能写成过江南。"
  },
  {
